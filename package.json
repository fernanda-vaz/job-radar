    "@prisma/client": "6.16.2",
    "discord.js": "14.18.0",
    "dotenv": "16.4.7",
    "fast-xml-parser": "5.2.5",
    "node-cron": "4.2.1",
    "pg": "8.13.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "prisma": "6.16.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
